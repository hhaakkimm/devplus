# Copy to app.env (git-ignored) and fill in. Read by every service in docker-compose.yml except redis.
DOMAIN=devplus.example.com
# URL-safe characters only (it goes into DATABASE_URL): openssl rand -hex 24
POSTGRES_PASSWORD=
# Replace ${POSTGRES_PASSWORD} with the actual password by hand.
DATABASE_URL=postgresql+asyncpg://devplus:${POSTGRES_PASSWORD}@postgres:5432/devplus
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Comma-separated GitHub logins
ALLOWED_GITHUB_LOGINS=
APP_ORIGIN=https://<DOMAIN>
COOKIE_SECURE=true
# Prompt evaluator. The worker reads the same file as api.
ANTHROPIC_API_KEY=
# REDIS_URL is set in docker-compose.yml (api and worker), do not add it here
# anthropic or fake (fake: canned answers, no API calls)
EVALS_LLM_BACKEND=anthropic
# USD limit per run
EVALS_RUN_COST_LIMIT_USD=5
EVALS_CONCURRENCY=4
# Code review: graded attempts per user per day
CODE_REVIEW_DAILY_LIMIT=10
CONTENT_DIR=/app/content
# Database backups (docs/deploy.md, "Бэкапы"): S3-compatible storage, the bucket must already exist
BACKUP_S3_ENDPOINT=https://s3.example.com
BACKUP_S3_BUCKET=devplus-backups
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
