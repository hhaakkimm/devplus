# Used by apps/api/Dockerfile instead of the root .dockerignore (that one is for the web image).
.git
.claude
.superpowers
**/.env*
**/__pycache__
**/.venv
**/.pytest_cache
**/.mypy_cache
**/.ruff_cache
**/.import_linter_cache
**/.coverage
**/htmlcov
apps/api/tests
apps/api/scripts
apps/api/Dockerfile
apps/api/Dockerfile.dockerignore
apps/web
packages
docs
infra
# content: tasks and simulator tasks only, lessons stay out. Trainer files are tasks/NN-slug.{yaml,mdx}, code review tasks
# are folders tasks/<slug>/** (task.yaml, reference_review.yaml, code/). Docker cleans the trailing slash,
# so `!content/*/tasks/` already takes everything under tasks/; the lines below say it out loud.
content/**
!content/*/tasks/
!content/*/tasks/*.yaml
!content/*/tasks/*.mdx
!content/*/tasks/*/**
# Simulator tasks are simulator/NN-slug.{yaml,mdx}.
!content/*/simulator/
!content/*/simulator/*.yaml
!content/*/simulator/*.mdx
